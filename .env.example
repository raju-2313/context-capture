# Public extension configuration (safe to enter in Settings; do not put provider secrets here).
VITE_TRANSCRIPTION_GATEWAY_URL=https://YOUR_PROJECT.supabase.co/functions/v1
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY
VITE_TRANSCRIPTION_UPGRADE_URL=https://YOUR_APP.example/upgrade

# Supabase Edge Function secrets (set with `supabase secrets set`; never commit values).
GROQ_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
